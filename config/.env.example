# OpenAI-compatible API Configuration
# Copy this file to .env and fill in your values

# API Base URL (e.g., https://api.openai.com/v1 or your custom endpoint)
OPENAI_API_BASE=https://api.openai.com/v1

# API Key
OPENAI_API_KEY=your-api-key-here

# Model name (e.g., gpt-4, gpt-3.5-turbo, or custom model)
OPENAI_MODEL=gpt-4

# Max iterations for the think-act-observe loop
MAX_ITERATIONS=10

# Enable debug logging (true/false)
DEBUG=true

# Planning loop: when true, the agent first generates a plan, lets you
# critique/refine it, then executes step-by-step. Disable for one-shot
# trivial tasks.
AGENT_PLANNING_ENABLED=true

# Maximum interactive refinement rounds before forcing a go/cancel prompt.
AGENT_MAX_PLAN_REFINEMENTS=5

# Autonomy mode: how much ceremony each task gets.
#   auto         → triage classifies (simple → no plan; standard → silent
#                  plan; complex → full review). Saves time on Q&A and
#                  routine work; full review only when scope warrants it.
#   interactive  → force the legacy flow: every task gets plan + critique
#                  + user-approval prompt, regardless of complexity.
#   silent       → plan every task but never prompt — auto-execute. Good
#                  for batch jobs or cron-style runs.
AGENT_AUTONOMY=auto

# Per-loop max_tokens for each LLM call type. Tune these if you hit
# truncation errors (raise) or want faster/cheaper runs (lower).
#   TAO            — inner Think/Act/Observe loop (largest; tool args
#                    like write_file content live here).
#   CRITIC         — final post-execution critic review.
#   PLAN_INITIAL   — first plan generation from the user request.
#   PLAN_CRITIQUE  — plan reviewer that surfaces gaps/improvements.
#   PLAN_REFINE    — plan revision after user feedback.
AGENT_MAX_TOKENS_TAO=15000
AGENT_MAX_TOKENS_CRITIC=5000
AGENT_MAX_TOKENS_PLAN_INITIAL=10000
AGENT_MAX_TOKENS_PLAN_CRITIQUE=15000
AGENT_MAX_TOKENS_PLAN_REFINE=15000

# Session logging: writes one JSONL event-stream + one Markdown summary
# per session to AGENT_LOG_DIR. Disable for trivial smoke tests.
AGENT_LOGGING_ENABLED=true
AGENT_LOG_DIR=logs

# Post-tool feedback loop: after every write_file/edit_file the
# FeedbackEngine runs deterministic checks and appends the result to
# the observation, so the agent can self-correct on the next iteration.
#
#   PYTHON_SYNTAX  — ast.parse on .py files (cheap, on by default)
#   JSON_SYNTAX    — json.load on .json files (cheap, on by default)
#   PYTHON_LINT    — ruff or pyflakes if installed (off by default)
#   TEST_CMD       — empty = disabled. Set e.g. "python -m py_compile src/agent.py"
#                    or your project's test command. Runs after every file mutation.
#   OUTPUT_CAP     — max chars of verifier detail appended per check.
AGENT_FEEDBACK_ENABLED=true
AGENT_FEEDBACK_PYTHON_SYNTAX=true
AGENT_FEEDBACK_JSON_SYNTAX=true
AGENT_FEEDBACK_PYTHON_LINT=false
AGENT_FEEDBACK_TEST_CMD=
AGENT_FEEDBACK_OUTPUT_CAP=500

# Browser tools (browser_visit / web_search): comma-separated list of
# hostnames the agent may NOT visit (subdomains included). Empty = no
# deny list. Examples:
#   AGENT_BROWSER_DENY_HOSTS=localhost,127.0.0.1,internal.corp
AGENT_BROWSER_DENY_HOSTS=